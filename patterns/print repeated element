import java.util.Scanner;
import java.util.HashSet;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int[]arr = new int[n];
        for(int i =0;i<n;i++){
            arr[i]= scn.nextInt();
        }
        printRepeatedElement(arr,n);
    }
    public static void printRepeatedElement(int[]arr,int n){
        HashSet<Integer>set = new HashSet<>();
        for(int i =0;i<n;i++){
            if(set.contains(arr[i])){
                System.out.println(arr[i]);
            }
            else{
                set.add(arr[i]);
            }
        }
    }
}