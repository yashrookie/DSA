import java.util.Scanner;
import java.util.HashSet;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int[]arr = new int[n];
        for(int i =0;i<n;i++){
            arr[i]= scn.nextInt();
        }
        printRepeatedElement(arr,n);
    }
    public static void printRepeatedElement(int[]arr,int n){
        for(int i =0;i<n;i++){
            for(int j =i+1;j<n;j++){
                if(arr[i]== arr[j]){
                    System.out.println(arr[i]);
                    break;
                }
            }
        }
    }
}