import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int[]arr = new int[n];
        for(int i =0;i<n;i++){
            arr[i]= scn.nextInt();
        }
        nonRepeatingElement(arr,n);
    }
    public static void nonRepeatingElement(int[]arr,int n){
        for(int i =0;i<n;i++){
            int count =0;
            for(int j =i+1;j<n;j++){
                if(arr[i]==arr[j] &&arr[i]!=0){
                    arr[j]= 0;
                    count++;
                }
            }
             if(count == 0 && arr[i]!=0){
            System.out.println(arr[i]+"non repeat element");
        }
        }
       
    }
}