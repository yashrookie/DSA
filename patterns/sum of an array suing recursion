import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int []arr = new int[n];
        for(int i =0;i<n;i++){
          arr[i]= scn.nextInt();  
        }
        System.out.println(getSum(arr,n));
    }
    public static int getSum(int []arr,int n){
        int sum =0;
        if( n == 0){
            return 0;
        }
        return arr[n - 1]+getSum(arr,n - 1);
    }
}