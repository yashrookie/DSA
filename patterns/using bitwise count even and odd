import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int[]arr = new int[n];
        for(int i =0;i<n;i++){
            arr[i]= scn.nextInt();
        }
        int countEven = 0;
        int countOdd = 0;
        for(int i =0;i<n;i++){
            if((arr[i] & 1) == 0){
                countEven +=1;
            }
            else {
                countOdd += 1;
            }
        }
        System.out.println("even" +countEven);
                System.out.println("odd" +countOdd);
    }
}