class Parent{
    void display(){
        System.out.println("parents");
    }
}
class child extends Parent{
    void display(){
        System.out.println("child");
    }
void show(){
    super.display();
}
}
public class Main{
    public static void main(String[]args){
        child obj = new child();
        obj.display();
        obj.show();
    }
}