import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int []arr = new int[n];
        int min = arr[0];
        for(int i =0;i<n;i++){
            arr[i]= scn.nextInt();
        }
        for(int i =0;i<n;i++){
            if(min>arr[i]){
                min = arr[i];
            }
        }
        System.out.println(min +" is the smallest element");
        }
}