import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n =scn.nextInt();
        int rev =0;
        int rem;
       int temp = n;
        while(temp!=0){
             rem = temp%10;
             rev =rev*10+rem;
             temp= temp/10;
            
        }
        if(n == rev){
            System.out.println(n+"is palindrome");
        }
        else{
            System.out.println(n+"not palindrome");
        }
    }
}