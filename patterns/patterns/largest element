import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int []arr = new int[n];
        int max = arr[0];
        for(int i =0;i<n;i++){
            arr[i]= scn.nextInt();
        }
        System.out.println(getMax(arr,n));
    }
    public static int getMax(int[]arr,int n){
        if(n ==1 ){
            return arr[0];
        }
        return Math.max(arr[n-1],getMax(arr,n-1));
    }
}