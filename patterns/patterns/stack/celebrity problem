import java.util.Scanner;
import java.util.Stack;
public class Main{
    public static void main(String[]args){
        int [][]matrix = {
            {0,1,1},{0,0,1},{0,0,0}
        };
        int n = matrix.length;
        int celebrity = findCelebrity(matrix,n);
        if(celebrity == -1){
            System.out.println("no celebrity");
        }
        else{
            System.out.println("celebrity is person" +celebrity);
        }
    }
    public static int findCelebrity(int [][]matrix,int n){
        Stack<Integer>stack = new Stack<>();
        for(int i =0;i<n;i++){
            stack.push(i);
        }
        while(stack.size()>1){
            int a = stack.pop();
            int b = stack.pop();
            if(matrix[a][b]== 1){
                stack.push(b);
            }
            else{
                stack.push(a);
            }
        }
        int candidate = stack.pop();
        for(int i =0;i<n;i++){
            if(i!=candidate){
                if(matrix[candidate][i] == 1 || matrix[i][candidate] == 0){
                    return -1;
                }
            }
        }
        return candidate;
    }
}