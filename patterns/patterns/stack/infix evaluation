import java.util.Scanner;
import java.util.Stack;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        String expression = scn.nextLine();
        System.out.println(evaluateInfix(expression));
    }
    public static int evaluateInfix(String exp){
        Stack<Integer>values= new Stack<>();
        Stack<Character>operators = new Stack<>();
        for(int i =0;i<exp.length();i++){
            char ch = exp.charAt(i);
            if(Character.isDigit(ch)){
                int num =0;
                while(i<exp.length() && Character.isDigit(exp.charAt(i))){
                    num = num*10+(exp.charAt(i) -'0');
                    i++;
                }
                i--;
                values.push(num);
            }
            else if(ch =='('){
                operators.push(ch);
            }
            else if(ch == ')'){
                while(!operators.isEmpty() && operators.peek()!='('){
                    processOperation(values,operators);
                }
                operators.pop();
            }
            else if(ch =='+' || ch =='-' || ch == '*' ||ch =='/'){
                    while(!operators.isEmpty() && precedence(operators.peek())>=precedence(ch)){
                        processOperation(values,operators);
                    }
                    operators.push(ch);
                }
            }
            while(!operators.isEmpty()){
                processOperation(values,operators);
            }
            return values.pop();
        }
        public static int precedence(char op){
            if(op =='+' || op =='-')return 1;
            if(op == '*' || op =='/' )return 2;
            return 0;
        }
        public static void processOperation(Stack<Integer>values,Stack<Character>operators){
            if(values.size()<2 || operators.isEmpty())return;
            int b = values.pop();
            int a= values.pop();
            char op = operators.pop();
            int result =0;
            if(op =='+')result = a+b;
            else if(op == '-')result = a-b;
            else if(op == '*')result = a*b;
            else if(op == '/')result = a/b;
            values.push(result);
        }
    }

