import java.util.Scanner;
import java.util.HashSet;
import java.util.Set;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int []arr = new int[n];
        for(int i =0;i<n;i++){
            arr[i]= scn.nextInt();
        }
        Set<Integer> hash_Set = new HashSet();
        for(int i =0;i<n;i++){
            hash_Set.add(arr[i]);
            System.out.println(hash_Set);
        }
    }
}