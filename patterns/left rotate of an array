import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int[]arr = new int[n];
        for(int i =0;i<n;i++){
            arr[i]= scn.nextInt();
        }
        int k = scn.nextInt();
        leftRotate(arr,k);
        for(int num:arr){
            System.out.print(num+" ");
        }
    }
    public static void leftRotate(int[]arr,int k){
        int n = arr.length;
        k =k%n;
        reverse(arr,0,k-1);
        reverse(arr,k,n-1);
        reverse(arr,0,n-1);
    }
    public static void reverse(int[]arr,int start,int end){
        while(start<end){
            int temp = arr[start];
            arr[start]= arr[end];
            arr[end]= temp;
            start++;
            end--;
        }
    }
}